# Copy to .env and fill in. .env is gitignored and never enters the image.

# Postgres. The session pooler string from the Supabase Connect dialog.
DATABASE_URL=

# The model the agent loop calls.
#
# Leave MODEL unset or set it to "stub" for an offline model that needs no key.
# That is what CI uses, so a push costs nothing.
#
# Any other value turns the stub off. Which provider a run actually uses then
# comes from its task type (app/tasks.py), not from MODEL: PROVIDERS in
# app/config.py maps each provider name to its own base URL, model, and key
# variable. Both entries below are what the registry currently names.
#
# Gemini free tier, through its OpenAI compatible endpoint, for pytest:
#   MODEL_API_KEY=your key from aistudio.google.com
# The free tier caps calls per day per model, and one run makes up to ten
# calls as it retries.
#
# Anthropic, through the Anthropic SDK, registered for later task types:
#   ANTHROPIC_API_KEY=your key from console.anthropic.com
MODEL=stub
MODEL_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings, from task 5 onward.
VOYAGE_API_KEY=

# Guards. Both are enforced, not decoration.
TOKEN_BUDGET=50000
MAX_RUNS_PER_DAY=20
